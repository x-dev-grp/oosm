# See deploy/vps/.env.example for the full VPS template.

PUBLIC_APP_URL=https://osm.example.com
WEB_PORT=80

BACKEND_IMAGE=ghcr.io/x-dev-grp/ooosm-backend:release-latest
FRONTEND_IMAGE=ghcr.io/x-dev-grp/oosm-frontend:release-latest

POSTGRES_DB=osm
DB_URL=jdbc:postgresql://postgres:5432/osm
DB_USER=osm
DB_PASS=change-me
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false
JWT_SECRET=change-me-use-a-long-random-string-at-least-32-characters
