# See deploy/vps/.env.example for the full VPS template.

PUBLIC_APP_URL=https://osm.example.com
WEB_PORT=80

BACKEND_IMAGE=ghcr.io/x-dev-grp/oosm-backend:release-latest
FRONTEND_IMAGE=ghcr.io/x-dev-grp/osm-frontend:release-latest

POSTGRES_DB=osm
DB_URL=jdbc:postgresql://postgres:5432/osm
DB_USER=osm
DB_PASS=change-me
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false
OAUTH2_CLIENT_SECRET=change-me
