# =============================================================================
# OOSM backend — Railway app + Render PostgreSQL (hybrid) — EXAMPLE
# Copy values into Railway → backend Variables (or copy to .env.railway.render-db locally).
# Replace CHANGE_ME_* and secrets. Do NOT commit real secrets.
#
# Do NOT add Railway Postgres. Do NOT run scripts/railway-link-postgres.sh.
# Do NOT set DATABASE_URL, PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD.
# =============================================================================

# --- Database (Render EXTERNAL host + sslmode=require) ---
DB_URL=jdbc:postgresql://dpg-d9576om7r5hc73e40l7g-a.frankfurt-postgres.render.com:5432/oosm_fawv?sslmode=require
DB_USER=oosm_fawv_user
DB_PASS=CHANGE_ME_RENDER_DB_PASSWORD

DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=300000
DB_INITIALIZATION_FAIL_TIMEOUT=10000
DB_MAJOR_VERSION=17
DB_MAX_LIFETIME=900000
DB_MINOR_VERSION=0
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1
DB_VALIDATION_TIMEOUT=5000

HIBERNATE_ALLOW_JDBC_METADATA_ACCESS=false
HIBERNATE_DDL_AUTO=none
JPA_REPOSITORY_BOOTSTRAP_MODE=lazy
SHOW_SQL=false
FORMAT_SQL=false
SPRING_SQL_INIT_MODE=never

JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:+UseSerialGC -Xms64m -Xmx384m -Xss512k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -XX:+ExitOnOutOfMemoryError
SPRING_APP_NAME=oosm-api
SPRING_MAIN_LAZY_INITIALIZATION=true
SPRING_JMX_ENABLED=false
SPRINGDOC_ENABLED=false
SEARCH_DEBUG_ON_STARTUP=false

TOMCAT_ACCEPT_COUNT=30
TOMCAT_MAX_CONNECTIONS=50
TOMCAT_MAX_THREADS=15
TOMCAT_MIN_SPARE_THREADS=2

JWT_ISSUER_URI=https://CHANGE_ME_BACKEND.up.railway.app
JWK_SET_URI=https://CHANGE_ME_BACKEND.up.railway.app/oauth2/jwks
INTERNAL_BASE_URL=https://CHANGE_ME_BACKEND.up.railway.app
FRONTEND_ENTRY_POINT=https://CHANGE_ME_FRONTEND.up.railway.app
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://CHANGE_ME_FRONTEND.up.railway.app,https://*.up.railway.app

OAUTH2_CLIENT_ID=oosm-client
OAUTH2_CLIENT_SECRET=
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MIN

SECURITY_BOOTSTRAP_ENABLED=true
SECURITY_BOOTSTRAP_USERNAME=oosmAdmin
SECURITY_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SECURITY_BOOTSTRAP_RESET_PASSWORD=false
SECURITY_BOOTSTRAP_EMAIL=oosmAdmin@example.com
SECURITY_BOOTSTRAP_PHONE=1234567819
PERMISSIONS_SYNC_ON_STARTUP=false
PRODUCTION_BOOTSTRAP_ENABLED=false
SECURITY_LEGACY_USER_MIGRATION_ENABLED=false

MAIL_ENABLED=true
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=OOSM
MAIL_SUPPORT_EMAIL=support@example.com
MAIL_DEBUG=false
RESEND_API_KEY=

ONESIGNAL_ENDPOINT=https://onesignal.com/api/v1/notifications
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

QR_BASE_URL=https://example.com/q/v1
SERVER_ERROR_INCLUDE_BINDING_ERRORS=never
SERVER_ERROR_INCLUDE_MESSAGE=never
HEALTH_SHOW_DETAILS=never
LOG_LEVEL_REST=WARN
LOG_LEVEL_WEB=INFO
