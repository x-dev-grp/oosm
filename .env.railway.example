# Railway backend variables — prefer railway.toml (auto Postgres references).
# If your Postgres service is NOT named "Postgres", rename it or edit railway.toml references.

# --- Database (auto via scripts/railway-link-postgres.sh) ---
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASS=${{Postgres.PGPASSWORD}}
# PGHOST=${{Postgres.PGHOST}}
# PGPORT=${{Postgres.PGPORT}}
# PGDATABASE=${{Postgres.PGDATABASE}}
#
# DO NOT set DB_URL on Railway — delete it if copied from Render (.env.render.example).
# A stale DB_URL like jdbc:postgresql://dpg-... causes UnknownHostException.

HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# --- Public URLs (replace after Railway assigns domains) ---
JWT_ISSUER_URI=https://your-backend.up.railway.app
JWK_SET_URI=https://your-backend.up.railway.app/oauth2/jwks
INTERNAL_BASE_URL=https://your-backend.up.railway.app
FRONTEND_ENTRY_POINT=https://your-frontend.up.railway.app
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend.up.railway.app,https://*.up.railway.app

# --- Auth ---
OAUTH2_CLIENT_ID=oosm-client
JWT_SECRET=X7kP9mN2vQ8rT4wY6zA1bC3dE5fG8hJ9

# --- Optional bootstrap admin (first deploy only) ---
SECURITY_BOOTSTRAP_ENABLED=true
SECURITY_BOOTSTRAP_USERNAME=oosmAdmin
SECURITY_BOOTSTRAP_PASSWORD=change-me-admin
SECURITY_BOOTSTRAP_RESET_PASSWORD=true
SECURITY_BOOTSTRAP_EMAIL=oosmAdmin@example.com

# --- Optional ---
MAIL_ENABLED=false
MAIL_USER=
MAIL_PASS=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Railway injects PORT automatically. Do not set SERVER_PORT.
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:+UseSerialGC -Xms64m -Xmx384m -XX:+ExitOnOutOfMemoryError
