# Import this file into the oosm-api service in Render.
# Replace every CHANGE_ME value before deployment.

DB_URL=jdbc:postgresql://CHANGE_ME:5432/postgres?sslmode=require
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

FRONTEND_ENTRY_POINT=https://oosm-web.onrender.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://oosm-web.onrender.com
JWT_ISSUER_URI=https://oosm-api.onrender.com
JWK_SET_URI=https://oosm-api.onrender.com/oauth2/jwks

OAUTH2_CLIENT_ID=osm-client
OAUTH2_CLIENT_SECRET=CHANGE_ME_MATCH_FRONTEND_CLIENT

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_ENDPOINT=https://onesignal.com/api/v1/notifications

LOG_LEVEL_WEB=INFO
LOG_LEVEL_REST=WARN
