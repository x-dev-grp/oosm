# Backend-only Render environment file.
# Replace every CHANGE_ME value, then import into oosm-api.

DB_URL=jdbc:postgresql://dpg-d8mm0t3tqb8s73c8v73g-a:5432/oosm?sslmode=require
DB_USER=oosm_user
DB_PASS=CHANGE_ME_RENDER_DATABASE_PASSWORD

SPRING_APP_NAME=oosm-api
HIBERNATE_DDL_AUTO=none
HIBERNATE_ALLOW_JDBC_METADATA_ACCESS=false
JPA_REPOSITORY_BOOTSTRAP_MODE=lazy
DB_MAJOR_VERSION=17
DB_MINOR_VERSION=0
SHOW_SQL=false
FORMAT_SQL=false

JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:+UseSerialGC -Xms64m -Xmx256m -Xss512k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -XX:+ExitOnOutOfMemoryError
SPRING_MAIN_LAZY_INITIALIZATION=true
SPRING_JMX_ENABLED=false
SPRINGDOC_ENABLED=false

DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000
DB_INITIALIZATION_FAIL_TIMEOUT=10000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=900000

TOMCAT_MAX_THREADS=20
TOMCAT_MIN_SPARE_THREADS=2
TOMCAT_MAX_CONNECTIONS=100
TOMCAT_ACCEPT_COUNT=50
SEARCH_DEBUG_ON_STARTUP=false

# Render provides RENDER_EXTERNAL_URL automatically and the backend derives:
# JWK_SET_URI=https://<render-backend-host>/oauth2/jwks
# Do not set JWK_SET_URI unless overriding that derived URL.

FRONTEND_ENTRY_POINT=http://localhost:4200
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200

OAUTH2_CLIENT_ID=osm-client
OAUTH2_CLIENT_SECRET=CHANGE_ME_OAUTH_CLIENT_SECRET

SECURITY_BOOTSTRAP_ENABLED=true
SECURITY_BOOTSTRAP_USERNAME=osmAdmin
SECURITY_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SECURITY_BOOTSTRAP_EMAIL=osmAdmin@example.com
SECURITY_BOOTSTRAP_PHONE=1234567819

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_TIMEOUT=5000
MAIL_CONN_TIMEOUT=5000

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_ENDPOINT=https://onesignal.com/api/v1/notifications

QR_BASE_URL=https://x-dev.pro/q/v1

SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_BINDING_ERRORS=never
HEALTH_SHOW_DETAILS=never

LOG_LEVEL_WEB=INFO
LOG_LEVEL_REST=WARN

# Do not set PORT, SERVER_PORT, RENDER_EXTERNAL_URL, INTERNAL_BASE_URL, or the
# PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD fallbacks. Render and DB_URL cover
# those values.
