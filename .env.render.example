# Backend-only Render environment file.
# Copy to .env.render, replace CHANGE_ME values, then import into oosm-api on Render.

# --- Database (Render PostgreSQL — internal hostname) ---
DB_URL=jdbc:postgresql://dpg-d9576om7r5hc73e4017g-a:5432/oosm_fawv?sslmode=require
DB_USER=oosm_fawv_user
DB_PASS=CHANGE_ME_RENDER_DATABASE_PASSWORD

# --- Application ---
SPRING_APP_NAME=oosm-api
HIBERNATE_DDL_AUTO=update
HIBERNATE_ALLOW_JDBC_METADATA_ACCESS=false
JPA_REPOSITORY_BOOTSTRAP_MODE=lazy
DB_MAJOR_VERSION=17
DB_MINOR_VERSION=0
SHOW_SQL=false
FORMAT_SQL=false

JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:+UseSerialGC -Xms64m -Xmx256m -Xss512k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -XX:+ExitOnOutOfMemoryError
SPRING_MAIN_LAZY_INITIALIZATION=true
SPRING_JMX_ENABLED=false
SPRINGDOC_ENABLED=false
SEARCH_DEBUG_ON_STARTUP=false

DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=30000
DB_VALIDATION_TIMEOUT=5000
DB_INITIALIZATION_FAIL_TIMEOUT=10000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=900000

TOMCAT_MAX_THREADS=20
TOMCAT_MIN_SPARE_THREADS=2
TOMCAT_MAX_CONNECTIONS=100
TOMCAT_ACCEPT_COUNT=50

FRONTEND_ENTRY_POINT=https://oosm-web.onrender.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.onrender.com,https://oosm-web.onrender.com

OAUTH2_CLIENT_ID=oosm-client
OAUTH2_CLIENT_SECRET=
JWT_SECRET=CHANGE_ME_JWT_SECRET

SECURITY_BOOTSTRAP_ENABLED=true
SECURITY_BOOTSTRAP_USERNAME=oosmAdmin
SECURITY_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SECURITY_BOOTSTRAP_RESET_PASSWORD=true
SECURITY_BOOTSTRAP_EMAIL=oosmAdmin@example.com
SECURITY_BOOTSTRAP_PHONE=1234567819

PERMISSIONS_SYNC_ON_STARTUP=false
PRODUCTION_BOOTSTRAP_ENABLED=true
SECURITY_LEGACY_USER_MIGRATION_ENABLED=true

MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME_SMTP_USER
MAIL_PASS=CHANGE_ME_SMTP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_TIMEOUT=5000
MAIL_CONN_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
MAIL_FROM_NAME=OOSM
MAIL_SUPPORT_EMAIL=CHANGE_ME_SMTP_USER
MAIL_DEBUG=false

ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_ENDPOINT=https://onesignal.com/api/v1/notifications

QR_BASE_URL=https://x-dev.pro/q/v1

SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_BINDING_ERRORS=never
HEALTH_SHOW_DETAILS=never

LOG_LEVEL_WEB=INFO
LOG_LEVEL_REST=WARN

# Do not set PORT, SERVER_PORT, RENDER_EXTERNAL_URL, INTERNAL_BASE_URL, or JWK_SET_URI.
